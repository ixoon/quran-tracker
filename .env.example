EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Google OAuth is configured in Supabase Dashboard (Auth > Providers > Google).
# Use the WEB application Client ID + Secret in Supabase — not the Android Client ID.
# Android OAuth client: keep in Google Cloud with package com.qurantracker.app + production SHA-1.
# Add redirect URL in Supabase: qurantracker://google-auth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
